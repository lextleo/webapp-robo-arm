# AVEON Web Application Environment Configuration

# Backend API URL (Leave blank when using local Vite reverse proxy)
VITE_API_BASE_URL=

# Real-Time Telemetry WebSocket URL
# Example for local: ws://localhost:8000
# Example for Cloudflare tunnel / production: wss://api-robotics.yourdomain.com
VITE_WS_URL=

# Camera Stream Fallback URL
VITE_ESP32_CAM_URL=http://192.168.4.1:81/stream
